 "dialogues": [
  {
   "id": "L1U09-D01",
   "title_vi": "Trái cây yêu thích",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "What's your favourite fruit?",
     "vi": "Cậu thích quả gì nhất?"
    },
    {
     "role": "Kid",
     "en": "Mango! It's sweet.",
     "vi": "Xoài! Nó ngọt."
    },
    {
     "role": "Bi",
     "en": "Do you like lemons?",
     "vi": "Cậu có thích chanh không?"
    },
    {
     "role": "Kid",
     "en": "No! Lemons are sour.",
     "vi": "Không! Chanh chua lắm."
    }
   ],
   "variation": {
    "line": 1,
    "key": "mango",
    "options": [
     "strawberry",
     "watermelon",
     "pineapple"
    ]
   }
  },
  {
   "id": "L1U09-D02",
   "title_vi": "Ăn rau nào",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Do you like vegetables?",
     "vi": "Cậu có thích rau củ không?"
    },
    {
     "role": "Kid",
     "en": "I like carrots but I don't like onions.",
     "vi": "Tớ thích cà rốt nhưng tớ không thích hành."
    },
    {
     "role": "Bi",
     "en": "Carrots are good for you!",
     "vi": "Cà rốt tốt cho cậu đấy!"
    },
    {
     "role": "Kid",
     "en": "Yes! Rabbits like carrots too.",
     "vi": "Ừ! Thỏ cũng thích cà rốt."
    }
   ],
   "variation": {
    "line": 1,
    "key": "carrots",
    "options": [
     "peas",
     "beans",
     "corn"
    ]
   }
  }
