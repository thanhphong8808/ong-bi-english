 "dialogues": [
  {
   "id": "L1U01-D01",
   "title_vi": "Giới thiệu gia đình",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Hi! Who's that?",
     "vi": "Chào! Ai kia thế?"
    },
    {
     "role": "Kid",
     "en": "That's my mother.",
     "vi": "Đó là mẹ tớ."
    },
    {
     "role": "Bi",
     "en": "Oh, hello! She's so nice!",
     "vi": "Ồ, chào cô ạ! Mẹ cậu hiền quá!"
    },
    {
     "role": "Kid",
     "en": "Thank you!",
     "vi": "Cảm ơn cậu!"
    }
   ],
   "variation": {
    "line": 1,
    "key": "mother",
    "options": [
     "father",
     "aunt",
     "grandmother"
    ]
   }
  },
  {
   "id": "L1U01-D02",
   "title_vi": "Xem ảnh",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Is this a photo of your family?",
     "vi": "Đây là ảnh gia đình cậu à?"
    },
    {
     "role": "Kid",
     "en": "Yes! This is my uncle.",
     "vi": "Ừ! Đây là chú tớ."
    },
    {
     "role": "Bi",
     "en": "And who's that boy?",
     "vi": "Thế cậu bé kia là ai?"
    },
    {
     "role": "Kid",
     "en": "He is my cousin.",
     "vi": "Em ấy là em họ tớ."
    },
    {
     "role": "Bi",
     "en": "He's funny!",
     "vi": "Em ấy trông vui quá!"
    }
   ],
   "variation": {
    "line": 1,
    "key": "uncle",
    "options": [
     "cousin",
     "brother",
     "grandfather"
    ]
   }
  },
  {
   "id": "L1U01-D03",
   "title_vi": "Ông bà",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Is your grandfather old?",
     "vi": "Ông cậu già chưa?"
    },
    {
     "role": "Kid",
     "en": "Yes. He's old and happy.",
     "vi": "Rồi. Ông già và vui vẻ."
    },
    {
     "role": "Bi",
     "en": "Do you love your grandparents?",
     "vi": "Cậu có yêu ông bà không?"
    },
    {
     "role": "Kid",
     "en": "Yes! I love my grandmother and grandfather.",
     "vi": "Có! Tớ yêu bà và ông."
    }
   ]
  }
 ],
