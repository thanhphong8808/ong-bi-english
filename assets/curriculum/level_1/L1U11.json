     "role": "Bi",
     "en": "Wow! So many!",
     "vi": "Chà! Nhiều thế!"
    },
    {
     "role": "Kid",
     "en": "Do you want one?",
     "vi": "Cậu có muốn một cái không?"
    },
    {
     "role": "Bi",
     "en": "Yes, please!",
     "vi": "Có ạ!"
    }
