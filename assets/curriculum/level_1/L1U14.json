 "dialogues": [
  {
   "id": "L1U14-D01",
   "title_vi": "Cậu ổn chứ?",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Are you okay?",
     "vi": "Cậu ổn chứ?"
    },
    {
     "role": "Kid",
     "en": "No. I feel sad.",
     "vi": "Không. Tớ thấy buồn."
    },
    {
     "role": "Bi",
     "en": "Oh no! Do you want a hug?",
     "vi": "Ôi! Cậu có muốn ôm một cái không?"
    },
    {
     "role": "Kid",
     "en": "Yes, please. Thank you, Bi.",
     "vi": "Có. Cảm ơn Bi."
    },
    {
     "role": "Bi",
     "en": "You're welcome.",
     "vi": "Không có gì."
    }
   ],
   "variation": {
    "line": 1,
    "key": "sad",
    "options": [
     "scared",
     "sick",
     "tired"
    ]
   }
  },
  {
   "id": "L1U14-D02",
   "title_vi": "Xin lỗi",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Kid",
     "en": "Oh no! I'm sorry, Bi.",
     "vi": "Ôi không! Tớ xin lỗi Bi."
    },
    {
     "role": "Bi",
     "en": "It's okay. No problem!",
     "vi": "Không sao. Không vấn đề gì đâu!"
    },
    {
     "role": "Kid",
     "en": "You are very kind.",
     "vi": "Cậu tốt bụng quá."
    },
    {
     "role": "Bi",
     "en": "Thank you! Let's play again.",
     "vi": "Cảm ơn cậu! Mình chơi tiếp nhé."
    }
   ]
  },
  {
   "id": "L1U14-D03",
   "title_vi": "Ốm rồi",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "How are you today?",
     "vi": "Hôm nay cậu thế nào?"
    },
    {
     "role": "Kid",
     "en": "I feel sick. My head is hot.",
     "vi": "Tớ thấy ốm. Đầu tớ nóng."
    },
    {
     "role": "Bi",
     "en": "Oh no! Tell your mum.",
     "vi": "Ôi! Cậu nói với mẹ đi."
    },
    {
     "role": "Kid",
     "en": "Okay. Thank you, Bi.",
     "vi": "Ừ. Cảm ơn Bi."
    }
   ]
  }
 ],
