   "title_vi": "Ở nông trại",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Do you like the farm?",
     "vi": "Cậu có thích nông trại không?"
    },
    {
     "role": "Kid",
     "en": "Yes! I see a sheep.",
     "vi": "Có! Tớ thấy một con cừu."
    },
    {
     "role": "Bi",
     "en": "Is it fast?",
     "vi": "Nó có nhanh không?"
    },
    {
     "role": "Kid",
     "en": "No. It's slow and funny.",
