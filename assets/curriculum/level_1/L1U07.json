  {
   "id": "L1U07-D01",
   "title_vi": "Ở sở thú",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Look! What's that?",
     "vi": "Nhìn kìa! Con gì thế kia?"
    },
    {
     "role": "Kid",
     "en": "It's a giraffe!",
     "vi": "Đó là hươu cao cổ!"
    },
    {
     "role": "Bi",
     "en": "Wow! It's so tall!",
     "vi": "Chà! Nó cao quá!"
    },
    {
     "role": "Kid",
     "en": "I like the giraffe.",
     "vi": "Tớ thích hươu cao cổ."
    }
   ],
   "variation": {
