 "dialogues": [
  {
   "id": "L1U12-D01",
   "title_vi": "Rủ đi công viên",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Let's go to the park!",
     "vi": "Mình đi công viên đi!"
    },
    {
     "role": "Kid",
     "en": "Okay! Can I go on the slide?",
     "vi": "Được! Tớ chơi cầu trượt được không?"
    },
    {
     "role": "Bi",
     "en": "Sure! Let's play together.",
     "vi": "Được chứ! Mình chơi cùng nhau nhé."
    },
    {
     "role": "Kid",
     "en": "Yay! It's fun!",
     "vi": "Hoan hô! Vui quá!"
    }
   ],
   "variation": {
    "line": 0,
    "key": "park",
    "options": [
     "playground",
     "lake"
    ]
   }
  },
  {
   "id": "L1U12-D02",
   "title_vi": "Giờ ra chơi",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Kid",
     "en": "Can I play too?",
     "vi": "Tớ chơi cùng được không?"
    },
    {
     "role": "Bi",
     "en": "Sure! It's your turn.",
     "vi": "Được chứ! Đến lượt cậu đấy."
    },
    {
     "role": "Kid",
     "en": "Thank you! Look, I'm on the swing!",
     "vi": "Cảm ơn cậu! Nhìn này, tớ đang ngồi xích đu!"
    },
    {
     "role": "Bi",
     "en": "Good! Now it's my turn.",
     "vi": "Giỏi lắm! Giờ đến lượt tớ."
    }
   ]
  },
  {
   "id": "L1U12-D03",
   "title_vi": "Trốn tìm",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Let's hide! One, two, three!",
     "vi": "Mình chơi trốn tìm nhé! Một, hai, ba!"
    },
    {
     "role": "Kid",
     "en": "Where is Bi? I can't find Bi.",
     "vi": "Bi đâu rồi? Tớ không tìm thấy Bi."
    },
    {
     "role": "Bi",
     "en": "I'm here! Under the bench!",
     "vi": "Tớ ở đây! Dưới ghế dài!"
    },
    {
     "role": "Kid",
     "en": "Oh! You are funny, Bi.",
     "vi": "Ồ! Bi buồn cười thật."
    }
   ]
  }
 ],
