     "crayon"
    ]
   }
  },
  {
   "id": "L1U04-D02",
   "title_vi": "Trong lớp",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Sit down, please. Open your book.",
     "vi": "Mời cậu ngồi. Mở sách ra nào."
    },
    {
     "role": "Kid",
     "en": "Okay! Can I read?",
     "vi": "Vâng! Tớ đọc được không?"
    },
    {
     "role": "Bi",
     "en": "Yes, you can.",
     "vi": "Được, cậu đọc đi."
    },
    {
     "role": "Kid",
     "en": "I like this lesson!",
     "vi": "Tớ thích bài học này!"
    }
   ]
  },
  {
   "id": "L1U04-D03",
   "title_vi": "Cô giáo",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Who's that woman?",
     "vi": "Người phụ nữ kia là ai?"
    },
    {
     "role": "Kid",
     "en": "She is my teacher.",
     "vi": "Đó là cô giáo tớ."
    },
    {
     "role": "Bi",
     "en": "Is she nice?",
     "vi": "Cô có hiền không?"
    },
    {
     "role": "Kid",
     "en": "Yes! I like my teacher.",
     "vi": "Có! Tớ quý cô giáo tớ."
    }
   ]
  }
