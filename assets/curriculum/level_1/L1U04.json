   "lines": [
    {
     "role": "Kid",
     "en": "Can I have a pencil, please?",
     "vi": "Cho tớ xin một cái bút chì được không?"
    },
    {
     "role": "Bi",
     "en": "Sure! Here you are.",
     "vi": "Được chứ! Của cậu đây."
    },
    {
     "role": "Kid",
     "en": "Thank you, Bi!",
     "vi": "Cảm ơn Bi!"
    },
    {
     "role": "Bi",
     "en": "You're welcome!",
     "vi": "Không có gì!"
    }
   ],
   "variation": {
    "line": 0,
