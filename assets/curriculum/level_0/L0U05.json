    {
     "role": "Kid",
     "en": "Yes! I like apples.",
     "vi": "Có! Tớ thích táo."
    },
    {
     "role": "Bi",
     "en": "Do you like milk?",
     "vi": "Cậu có thích sữa không?"
    },
    {
     "role": "Kid",
     "en": "No. I don't like milk.",
     "vi": "Không. Tớ không thích sữa."
    }
   ],
