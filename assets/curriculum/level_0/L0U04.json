 "dialogues": [
  {
   "id": "L0U04-D01",
   "title_vi": "Con gì đây?",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Look! What is it?",
     "vi": "Nhìn kìa! Con gì thế?"
    },
    {
     "role": "Kid",
     "en": "It's a cat.",
     "vi": "Đó là con mèo."
    },
    {
     "role": "Bi",
     "en": "Yes! It's a black cat.",
     "vi": "Đúng rồi! Đó là con mèo đen."
    },
    {
     "role": "Kid",
     "en": "I like the cat.",
     "vi": "Tớ thích con mèo."
    }
   ],
   "variation": {
    "line": 1,
    "key": "cat",
    "options": [
     "dog",
     "duck",
     "rabbit"
    ]
   }
  },
  {
   "id": "L0U04-D02",
   "title_vi": "Bi là ong",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Kid",
     "en": "Bi, are you a bird?",
     "vi": "Bi ơi, cậu là chim à?"
    },
    {
     "role": "Bi",
     "en": "No! I'm a bee.",
     "vi": "Không! Tớ là ong."
    },
    {
     "role": "Kid",
     "en": "Oh! A yellow and black bee.",
     "vi": "Ồ! Một chú ong vàng và đen."
    },
    {
     "role": "Bi",
     "en": "Yes! Thank you.",
     "vi": "Đúng rồi! Cảm ơn cậu."
    }
   ]
  }
 ],
