   "id": "L2U05-D01",
   "title_vi": "Ở tiệm bánh",
   "roles": [
    "Shopkeeper",
    "Kid"
   ],
   "lines": [
    {
     "role": "Shopkeeper",
     "en": "Hello! Can I help you?",
     "vi": "Chào cháu! Cô giúp gì được cháu?"
    },
    {
     "role": "Kid",
     "en": "Hello! How much is the cake?",
     "vi": "Cháu chào cô! Bánh ngọt bao nhiêu tiền ạ?"
    },
    {
     "role": "Shopkeeper",
     "en": "It's twenty thousand dong.",
     "vi": "Hai mươi nghìn đồng cháu ạ."
    },
    {
     "role": "Kid",
     "en": "I'll take one, please.",
     "vi": "Cháu lấy một cái ạ."
    },
    {
     "role": "Shopkeeper",
     "en": "Here you are.",
     "vi": "Của cháu đây."
    },
    {
     "role": "Kid",
     "en": "Thank you!",
     "vi": "Cháu cảm ơn cô!"
    }
   ],
   "variation": {
    "line": 1,
    "key": "cake",
    "options": [
     "bread",
     "sandwich"
    ]
   }
  },
  {
