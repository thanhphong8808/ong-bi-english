 "dialogues": [
  {
   "id": "L2U10-D01",
   "title_vi": "Ai cao hơn?",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Who is taller, you or your brother?",
     "vi": "Ai cao hơn, cậu hay anh cậu?"
    },
    {
     "role": "Kid",
     "en": "My brother is taller than me.",
     "vi": "Anh tớ cao hơn tớ."
    },
    {
     "role": "Bi",
     "en": "Is he older?",
     "vi": "Anh ấy lớn tuổi hơn à?"
    },
    {
     "role": "Kid",
     "en": "Yes. He is ten.",
     "vi": "Ừ. Anh ấy mười tuổi."
    }
   ],
   "variation": {
    "line": 1,
    "key": "taller",
    "options": [
     "bigger",
     "faster"
    ]
   }
  },
  {
   "id": "L2U10-D02",
   "title_vi": "Con vật nào to nhất?",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "What's the biggest animal?",
     "vi": "Con vật nào to nhất?"
    },
    {
     "role": "Kid",
     "en": "The elephant?",
     "vi": "Con voi à?"
    },
    {
     "role": "Bi",
     "en": "No. The whale is bigger than the elephant!",
     "vi": "Không. Cá voi to hơn voi!"
    },
    {
     "role": "Kid",
     "en": "Wow! The whale is the biggest!",
     "vi": "Ồ! Cá voi là to nhất!"
    }
   ],
   "variation": {
    "line": 3,
    "key": "whale",
    "options": [
     "elephant",
     "giraffe"
    ]
   }
  }
