 "dialogues": [
  {
   "id": "L2U04-D01",
   "title_vi": "Bữa sáng",
   "roles": [
    "Mum",
    "Kid"
   ],
   "lines": [
    {
     "role": "Mum",
     "en": "What do you want for breakfast?",
     "vi": "Con muốn ăn sáng món gì?"
    },
    {
     "role": "Kid",
     "en": "Can I have some toast, please?",
     "vi": "Cho con ít bánh mì nướng ạ?"
    },
    {
     "role": "Mum",
     "en": "Sure. With butter or honey?",
     "vi": "Được. Phết bơ hay mật ong?"
    },
    {
     "role": "Kid",
     "en": "Honey, please!",
     "vi": "Mật ong ạ!"
    },
    {
     "role": "Mum",
     "en": "Here you are.",
     "vi": "Của con đây."
    },
    {
     "role": "Kid",
     "en": "Thank you. It's delicious!",
     "vi": "Con cảm ơn. Ngon quá!"
    }
   ],
   "variation": {
    "line": 1,
    "key": "toast",
    "options": [
     "cereal",
     "pancakes"
    ]
   }
  },
  {
   "id": "L2U04-D02",
   "title_vi": "Làm bánh kếp",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Let's make pancakes!",
     "vi": "Mình làm bánh kếp đi!"
    },
    {
     "role": "Kid",
     "en": "Yes! What do we need?",
     "vi": "Ừ! Mình cần gì?"
    },
    {
     "role": "Bi",
     "en": "Eggs, milk and flour.",
     "vi": "Trứng, sữa và bột mì."
    },
    {
     "role": "Kid",
     "en": "I can mix the eggs.",
     "vi": "Tớ trộn trứng được."
    },
    {
     "role": "Bi",
