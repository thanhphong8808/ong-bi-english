   ],
   "lines": [
    {
     "role": "Bi",
     "en": "What sport do you like?",
     "vi": "Cậu thích môn thể thao nào?"
    },
    {
     "role": "Kid",
     "en": "I like football.",
     "vi": "Tớ thích bóng đá."
    },
    {
     "role": "Bi",
     "en": "Are you good at it?",
     "vi": "Cậu có giỏi không?"
    },
    {
     "role": "Kid",
     "en": "Yes! I can score goals.",
     "vi": "Có! Tớ ghi bàn được."
    },
    {
     "role": "Bi",
     "en": "Cool! Let's play together.",
     "vi": "Hay quá! Mình cùng chơi nhé."
    }
   ],
