 "dialogues": [
  {
   "id": "L2U11-D01",
   "title_vi": "Ở phòng khám",
   "roles": [
    "Doctor",
    "Kid"
   ],
   "lines": [
    {
     "role": "Doctor",
     "en": "Hello. What's the matter?",
     "vi": "Chào cháu. Cháu bị làm sao?"
    },
    {
     "role": "Kid",
     "en": "I have a headache.",
     "vi": "Cháu bị đau đầu ạ."
    },
    {
     "role": "Doctor",
     "en": "Let's take your temperature.",
     "vi": "Để bác đo nhiệt độ nhé."
    },
    {
     "role": "Kid",
     "en": "Do I have a fever?",
     "vi": "Cháu có bị sốt không ạ?"
    },
    {
     "role": "Doctor",
     "en": "Yes, a little. Take this medicine and rest.",
     "vi": "Có, hơi sốt. Uống thuốc này và nghỉ ngơi nhé."
    },
    {
     "role": "Kid",
     "en": "Thank you, doctor.",
     "vi": "Cháu cảm ơn bác sĩ."
    }
   ],
   "variation": {
    "line": 1,
    "key": "headache",
    "options": [
     "cough",
     "fever"
    ]
   }
  },
  {
   "id": "L2U11-D02",
   "title_vi": "Bạn ốm",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
