 "dialogues": [
  {
   "id": "L2U09-D01",
   "title_vi": "Hôm qua cậu làm gì?",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "What did you do yesterday?",
     "vi": "Hôm qua cậu đã làm gì?"
    },
    {
     "role": "Kid",
     "en": "I went to the zoo.",
     "vi": "Tớ đã đi sở thú."
    },
    {
     "role": "Bi",
     "en": "What did you see?",
     "vi": "Cậu đã thấy gì?"
    },
    {
     "role": "Kid",
     "en": "I saw a lion and two zebras.",
     "vi": "Tớ đã thấy một con sư tử và hai con ngựa vằn."
    },
    {
     "role": "Bi",
     "en": "Wow! Was it fun?",
     "vi": "Ồ! Có vui không?"
    },
    {
     "role": "Kid",
     "en": "Yes, it was really fun!",
     "vi": "Có, vui thật sự!"
    }
   ],
   "variation": {
    "line": 1,
    "key": "zoo",
    "options": [
     "park",
     "beach"
    ]
   }
  },
  {
   "id": "L2U09-D02",
   "title_vi": "Kỳ nghỉ",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Where did you go on holiday?",
     "vi": "Cậu đi nghỉ ở đâu?"
    },
    {
     "role": "Kid",
     "en": "We went to the beach.",
     "vi": "Nhà tớ đi biển."
    },
    {
     "role": "Bi",
     "en": "Did you swim?",
     "vi": "Cậu có bơi không?"
    },
    {
     "role": "Kid",
     "en": "Yes! I swam every day.",
     "vi": "Có! Ngày nào tớ cũng bơi."
    }
   ],
   "variation": {
    "line": 1,
    "key": "beach",
    "options": [
