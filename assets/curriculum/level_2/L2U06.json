    {
     "role": "Kid",
     "en": "I want to go to the cinema.",
     "vi": "Tớ muốn đi xem phim."
    },
    {
     "role": "Bi",
     "en": "Me too! Where is it?",
     "vi": "Tớ cũng thế! Rạp ở đâu?"
    },
    {
     "role": "Kid",
     "en": "It's behind the supermarket.",
     "vi": "Nó ở sau siêu thị."
    }
   ],
