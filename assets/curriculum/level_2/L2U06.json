   ],
   "lines": [
    {
     "role": "Kid",
     "en": "Excuse me, where is the library?",
     "vi": "Xin lỗi, thư viện ở đâu ạ?"
    },
    {
     "role": "Bi",
     "en": "Go straight on. Then turn left.",
     "vi": "Đi thẳng. Rồi rẽ trái."
    },
    {
     "role": "Kid",
     "en": "Is it next to the bank?",
     "vi": "Nó ở cạnh ngân hàng à?"
    },
    {
     "role": "Bi",
     "en": "No. It's opposite the bank.",
     "vi": "Không. Nó ở đối diện ngân hàng."
    },
    {
     "role": "Kid",
     "en": "Thank you!",
     "vi": "Cảm ơn cậu!"
    }
   ],
   "variation": {
    "line": 0,
    "key": "library",
    "options": [
     "museum",
     "cinema"
    ]
   }
  },
  {
