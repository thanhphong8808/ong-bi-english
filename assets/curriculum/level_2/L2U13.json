  {
   "id": "L2U13-D01",
   "title_vi": "Về quê",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
     "role": "Bi",
     "en": "Where does your grandma live?",
     "vi": "Bà cậu sống ở đâu?"
    },
    {
     "role": "Kid",
     "en": "In a village in the countryside.",
     "vi": "Ở một ngôi làng ở nông thôn."
    },
    {
     "role": "Bi",
     "en": "What can you see there?",
     "vi": "Ở đó cậu thấy gì?"
    },
    {
     "role": "Kid",
     "en": "I can see a buffalo and rice fields.",
     "vi": "Tớ thấy con trâu và ruộng lúa."
    },
    {
     "role": "Bi",
     "en": "Is it quiet?",
     "vi": "Ở đó có yên tĩnh không?"
    },
    {
     "role": "Kid",
     "en": "Yes. The air is very fresh.",
     "vi": "Có. Không khí rất trong lành."
    }
   ],
   "variation": {
    "line": 3,
    "key": "buffalo",
    "options": [
     "ducks",
     "chickens"
    ]
   }
  },
  {
   "id": "L2U13-D02",
   "title_vi": "Gieo hạt",
   "roles": [
    "Bi",
    "Kid"
   ],
   "lines": [
    {
